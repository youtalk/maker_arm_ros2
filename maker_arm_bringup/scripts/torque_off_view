#!/usr/bin/env python3
"""Publish the arm's joint states with no torque, for RViz.

    ros2 run maker_arm_bringup torque_off_view --interface can0 --profile FILE [--gripper-map FILE]

It runs `maker-arm-cli scan --watch`, which only reads the motors and never enables one. Each
WATCH line becomes one /joint_states message. A line with a nan, a motor that did not answer or
reports a fault, is skipped, and its nan joints are logged at most once a second.
`--interface sim` runs the built-in simulator. `--gripper-map` is a file with one line "a,b".
It stops the scan when it gets SIGINT or SIGTERM.
"""

import argparse
import math
import signal
import subprocess
import sys

import rclpy
from sensor_msgs.msg import JointState

NAMES = [f"link_00{i}_joint" for i in range(2, 8)] + ["gripper_left_joint"]


def parse_watch(line):
    """Return the JointState of a WATCH line, or None for another line."""
    f = line.split()
    if len(f) != 2 + len(NAMES) or f[0] != "WATCH":
        return None
    return JointState(name=NAMES, position=[float(x) for x in f[2:]])


def silent(msg):
    """Return the joints of msg that read nan (or inf)."""
    return [n for n, q in zip(msg.name, msg.position) if not math.isfinite(q)]


def command(interface, profile, gripper_map):
    """Return the scan command. It only ever runs `scan --watch`."""
    iface = ["--sim"] if interface == "sim" else ["--can", interface]
    cmd = ["maker-arm-cli", *iface, "scan", "--watch"]
    if profile:
        cmd += ["--profile", profile]
    if gripper_map:
        cmd += ["--gripper_map", gripper_map]
    return cmd


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--interface", default="can0")
    ap.add_argument("--profile", default="")
    ap.add_argument("--gripper-map", default="")
    args, ros_args = ap.parse_known_args()
    gripper_map = ""
    if args.gripper_map:
        with open(args.gripper_map) as f:
            gripper_map = f.read().strip()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    rclpy.init(args=ros_args)
    node = rclpy.create_node("torque_off_view")
    pub = node.create_publisher(JointState, "/joint_states", 10)
    scan = subprocess.Popen(command(args.interface, args.profile, gripper_map),
                            stdout=subprocess.PIPE, text=True)
    try:
        for line in scan.stdout:
            msg = parse_watch(line)
            if not msg:
                continue
            if missing := silent(msg):
                node.get_logger().warning(
                    f"no reading from {', '.join(missing)}: the motor did not answer or "
                    "reports a fault. RViz keeps the last pose.",
                    throttle_duration_sec=1.0)
                continue
            msg.header.stamp = node.get_clock().now().to_msg()
            pub.publish(msg)
    except (KeyboardInterrupt, SystemExit):
        pass
    finally:
        scan.terminate()
        scan.wait()
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()
    return scan.returncode if scan.returncode > 0 else 0


if __name__ == "__main__":
    sys.exit(main())
