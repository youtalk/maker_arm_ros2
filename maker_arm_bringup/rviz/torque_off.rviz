Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: mount_link
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
Window Geometry: {}
