Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: mount_link
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.9
      Focal Point:
        X: 0
        Y: 0
        Z: 0.15
      Pitch: 0.45
      Yaw: 0.8
      Target Frame: <Fixed Frame>
Window Geometry: {}
