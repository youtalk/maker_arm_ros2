<?xml version="1.0"?>
<package format="3">
  <name>maker_arm_mujoco</name>
  <version>0.1.0</version>
  <description>MuJoCo plant for the MakerMods Maker Arm that answers on vcan0 as its RobStride motors</description>
  <maintainer email="youtalk@users.noreply.github.com">Yutaka Kondo</maintainer>
  <license>Apache-2.0</license>

  <!-- mujoco is not a rosdep key: pip install mujoco==3.13.0 (README.md). -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>maker_arm_description</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
